# =============================================================
# Simple Healthcare – Example Environment Variables
# =============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env – only commit .env.example

# ------- Database (NeonDB / PostgreSQL) -------
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ------- Backend API -------
BACKEND_PORT=5207
BACKEND_BASE_URL=http://localhost:5207

# ------- Frontend (Angular) -------
FRONTEND_PORT=4200
FRONTEND_BASE_URL=http://localhost:4200

# ------- Admin (Backend only – set in backend/.env) -------
# These credentials gate the POST /api/auth/register-doctor endpoint.
# Only requests supplying matching X-Admin-Email / X-Admin-Password headers
# are allowed to register doctors. Patients self-register freely.
Admin__Email="admin@healthcare.local"
Admin__Password="Admin@1234"
